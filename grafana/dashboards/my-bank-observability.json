{
  "uid": "my-bank-observability",
  "title": "My Bank Observability",
  "tags": ["my-bank", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP RPS",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 4xx / 5xx",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..|5..\"}[1m])) by (job, status)",
          "legendFormat": "{{job}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (job, le))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM memory used",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "sum(jvm_memory_used_bytes) by (job, area)",
          "legendFormat": "{{job}} {{area}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Business failures",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "sum(increase(bank_cash_withdraw_failed_total[5m])) by (login)",
          "legendFormat": "cash withdraw {{login}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "sum(increase(bank_transfer_failed_total[5m])) by (fromLogin, toLogin)",
          "legendFormat": "transfer {{fromLogin}} -> {{toLogin}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "sum(increase(bank_notification_failed_total[5m])) by (login)",
          "legendFormat": "notification {{login}}"
        }
      ]
    }
  ]
}
